# cmake -DOUT=header.hpp -DFILES="a;b;c" -P EmbedFiles.cmake
# Writes a header with one byte array per file and a table
#   kUiAssets[] = { {"name", data, size}, ... }
# used by src/web/UiAssets.cpp.
set(_body "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#pragma once\n#include <cstddef>\n\nnamespace reforce::web::generated {\n\n")
set(_table "")
set(_i 0)
foreach(_f IN LISTS FILES)
    get_filename_component(_name "${_f}" NAME)
    file(READ "${_f}" _hex HEX)
    string(LENGTH "${_hex}" _hexlen)
    math(EXPR _size "${_hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
    string(APPEND _body "inline constexpr unsigned char kAsset${_i}[] = {\n${_bytes}0x00};\n\n")
    string(APPEND _table "    {\"${_name}\", kAsset${_i}, ${_size}},\n")
    math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _body "struct EmbeddedFile { const char* name; const unsigned char* data; std::size_t size; };\n")
string(APPEND _body "inline constexpr EmbeddedFile kUiAssets[] = {\n${_table}};\n\n}  // namespace reforce::web::generated\n")
get_filename_component(_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_dir}")
file(WRITE "${OUT}" "${_body}")
