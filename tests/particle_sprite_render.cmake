# ctest: deterministic offline render of a particle and two sprites, all our
# own content (configs written here, test card images generated by
# reforce_png_probe). A 'void' FlowField clears the buffer every frame and a
# gray ColorMap with MapFunction "i" makes pixel = intensity x 255, so the
# particle's pen follows the probe #19 envelope (1 s fades, PDur 1 s):
#   spawn t = 0.1; age .5 -> 1-(.5)^1.5 = .646 (165); age 1.5 -> 1 (255);
#   age 2.5 -> (.5)^1.5 = .354 (90); age > 3 -> gone (0).
# Path 1 uses Pen = FADER, so it shows envelope^2 (FADER exposed to expressions).
# Sprites (Flag 0: native 64x32, copy, Pen 1, EPen 0) fade the same way; the
# "~" one (whose file name also starts with spaces) is inverted.
# Inputs: REFORCE, PNG_PROBE, WORK_DIR.
file(REMOVE_RECURSE "${WORK_DIR}")
set(P "${WORK_DIR}/scenes/Packages")
file(MAKE_DIRECTORY "${WORK_DIR}/out")

file(WRITE "${P}/G-Force.FlowField.package/Void.txt" "srcX=\"5\"\nsrcY=\"5\"\n")
file(WRITE "${P}/G-Force.WaveShape.package/WaveShapes/Off.txt" "ConB=0 Stps=2\nX0=\"5\" Y0=\"5\" Pen=\"0\"\n")
file(WRITE "${P}/G-Force.WaveShape.package/Particles/Test Dot.txt"
     "// #waveshape-particle-only\nAspc=0 ConB=0 Stps=1\nX0=\"0\" Y0=\".5\"\nX1=\"0\" Y1=\"-.5\"\n"
     "Pen=\"1 - PATH_ID + PATH_ID * FADER\"\nLWdt=\"20\"\nPDur=\"1\"\n")
file(WRITE "${P}/G-Force.ColorMap.package/Gray.txt" "R=\"i\" G=\"i\" B=\"i\"\n")
set(S "${P}/G-Force.Sprite.package")
file(MAKE_DIRECTORY "${S}/Test")
file(WRITE "${S}/_default_sprite_params.txt" "X=\"0\" Y=\"0\" EPen=\"1\" Flag=7\n")
execute_process(COMMAND "${PNG_PROBE}" --make-test-image "${S}/Test/Card.png" 64 32 RESULT_VARIABLE rc1)
execute_process(COMMAND "${PNG_PROBE}" --make-test-image "${S}/Test/  Card Inv~.png" 64 32 RESULT_VARIABLE rc2)
if(NOT rc1 EQUAL 0 OR NOT rc2 EQUAL 0)
    message(FATAL_ERROR "could not write the test images")
endif()
file(WRITE "${S}/Test/Card.txt" "X=\".5\" Y=\"0\" Pen=\"1\" EPen=\"0\" Flag=\"0\" PDur=\"1\"\n")
file(WRITE "${S}/Test/  Card Inv~.txt" "X=\"-.5\" Y=\"0\" Pen=\"1\" EPen=\"0\" PDur=\"1\"\n")

execute_process(
    COMMAND "${REFORCE}" --no-settings --no-audio --deterministic --render-frames 201 --fps 60
            --render-size 320x180 --scenes "${WORK_DIR}/scenes" --slideshow off
            --flowfield Void --waveshape Off --colormap Gray
            --set ColorMap.MapFunction=i
            --set Particle.Transition.Duration=1 --set Particle.Transition.Duration.Deviation=0
            --set Sprite.Transition.Duration=1 --set Sprite.Transition.Duration.Deviation=0
            "--command" "0.1=start:particle:Test Dot"
            "--command" "0.1=start:sprite:Card"
            "--command" "0.1=start:sprite:card inv~"
            --out "${WORK_DIR}/out" --save-frames 36,96,156,200
    RESULT_VARIABLE rc
    OUTPUT_VARIABLE out
    ERROR_VARIABLE err)
file(WRITE "${WORK_DIR}/log.txt" "${out}${err}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "reforce exited with ${rc}:\n${err}")
endif()
foreach(want
        "Particle \"Test Dot\" starts"
        "Sprite \"Card\" starts: 64x32 -> 64x32 px, flags 0 (0), copy, Pen"
        "Sprite \"  Card Inv~\" starts"
        ", inverted"
        "1 particle(s) ended"
        "Sprite \"Card\" ended")
    string(FIND "${err}" "${want}" pos)
    if(pos EQUAL -1)
        message(FATAL_ERROR "missing in the log: ${want}\n${err}")
    endif()
endforeach()

# Probe points (320x180): particle path 0 at (160,45), path 1 (Pen = FADER) at (160,135);
# Card (native 64x32 at X = .5: center .5 x (1 - 64/320) = .4 -> x 224, probe #41) white half (208,90), black half
# (240,90); inverted card (X = -.5 -> x 96): (80,90) was white, (112,90) was black.
function(probe frame)
    execute_process(COMMAND "${PNG_PROBE}" "${WORK_DIR}/out/frame_${frame}.png" ${ARGN}
                    RESULT_VARIABLE rc OUTPUT_VARIABLE pout ERROR_VARIABLE perr)
    message(STATUS "${pout}${perr}")
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "pixel probe failed for frame ${frame}")
    endif()
endfunction()
# age .5: fade-in .646 (165), FADER^2 .418 (107)
probe(00036 "160,45,160,170" "160,135,101,113" "208,90,160,170" "240,90,0,4" "80,90,0,4" "112,90,160,170")
# age 1.5: full
probe(00096 "160,45,250,255" "160,135,250,255" "208,90,250,255" "240,90,0,4" "80,90,0,4" "112,90,250,255")
# age 2.5: fade-out (1 - .5)^1.5 = .354 (90), squared .125 (32)
probe(00156 "160,45,85,95" "160,135,27,37" "208,90,85,95" "240,90,0,4" "80,90,0,4" "112,90,85,95")
# age 3.23: all gone
probe(00200 "160,45,0,4" "160,135,0,4" "208,90,0,4" "112,90,0,4")
