#!/bin/bash
# Runs a aist_import tool in its venv, creating the venv on first use:  tools/aist_import/run build_moves.py ~/reforce/aist/data content/Moves/aist.moves
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
if [[ ! -x "$here/.venv/bin/python" ]]; then
    py="$(command -v python3.11 || command -v python3.12 || command -v python3)"
    "$py" -m venv "$here/.venv"
    "$here/.venv/bin/pip" install -q -r "$here/requirements.txt"
fi
tool="$1"; shift
exec "$here/.venv/bin/python" "$here/$tool" "$@"
